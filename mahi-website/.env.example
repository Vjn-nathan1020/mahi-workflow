# ---------------------------------------------------------------------------
# MAHI – environment variables (ALL OPTIONAL)
#
# With NO variables set, MAHI runs in LOCAL mode: no login, no database,
# everything saved automatically in the visitor's own browser. That is the
# default for a zero-configuration Vercel deployment.
#
# Fill in the Supabase values below only if you later want secure login +
# sync across devices (CLOUD mode). Copy to `.env.local` for local development;
# in Vercel add them under Project ▸ Settings ▸ Environment Variables.
# ---------------------------------------------------------------------------

# Force LOCAL mode even if Supabase values are present: local | cloud
VITE_STORAGE_MODE=local

# --- CLOUD mode only -------------------------------------------------------
# Supabase ▸ Project Settings ▸ API ▸ "Project URL"
VITE_SUPABASE_URL=
# Supabase ▸ Project Settings ▸ API ▸ "anon public" key (public by design, protected by RLS).
# NEVER use the "service_role" key here or anywhere in this project.
VITE_SUPABASE_ANON_KEY=
# Show a "Create account" link on the sign-in page (keep false for a personal site).
VITE_ALLOW_SIGNUP=false
# Automatically sign out after this many minutes without activity (0 = never).
VITE_IDLE_SIGNOUT_MINUTES=0
